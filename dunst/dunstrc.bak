[global]
    ### Apariencia General ###
    monitor = 0
    follow = mouse
    width = 320
    height = 150
    origin = top-right
    offset = 15x15
    scale = 0
    notification_limit = 5
    
    ### Estilo y Fuente ###
    # Asegúrate de tener instalada una fuente JetBrainsMono o similar
    font = SauceCodePro Nerd Font 14
    line_height = 4
    format = "<b>%s</b>\n%b"
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    
    ### Bordes y Separadores (Tokyo Night) ###
    frame_width = 2
    separator_color = frame
    corner_radius = 8
    padding = 12
    horizontal_padding = 12
    
    ### Iconos ###
    icon_position = left
    max_icon_size = 48
    # Ajusta esta ruta según tu pack de iconos
    icon_path = /usr/share/icons/Papirus-Dark/48x48/status:/usr/share/icons/Papirus-Dark/48x48/devices

[urgency_low]
    # Fondo azul oscuro, texto gris azulado, borde azul tenue
    background = "#1a1b26"
    foreground = "#a9b1d6"
    frame_color = "#414868"
    timeout = 5

[urgency_normal]
    # Fondo azul oscuro, texto blanco azulado, borde Cyan (Tokyo Night)
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#7dcfff"
    timeout = 10

[urgency_critical]
    # Fondo azul oscuro, texto rojo/magenta, borde Rojo brillante
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
